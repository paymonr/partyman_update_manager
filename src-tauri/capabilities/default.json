{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for BedWatch Updater",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-execute",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "autostart:default",
    "notification:default"
  ]
}